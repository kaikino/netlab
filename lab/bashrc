# netlab shell
[ -z "$PS1" ] && return
export HISTFILE=/root/.netlab/bash_history HISTSIZE=5000 HISTCONTROL=ignoredups
shopt -s histappend checkwinsize
[ -f /usr/share/bash-completion/bash_completion ] && . /usr/share/bash-completion/bash_completion

alias ls='ls --color=auto' grep='grep --color=auto' ll='ls -alF'

# Prompt shows the current lab and, when you're "on" a host, its namespace.
__netlab_ps1() {
  local ns lab
  ns=$(ip netns identify 2>/dev/null)
  lab=$(python3 -c 'import json;print(json.load(open("/root/.netlab/progress.json")).get("current") or "")' 2>/dev/null)
  [ -n "$lab" ] && printf '\001\033[2m\002lab %s \001\033[0m\002' "$lab"
  [ -n "$ns" ] && printf '\001\033[1;33m\002[%s] \001\033[0m\002' "$ns"
}
PS1='$(__netlab_ps1)\[\033[1;36m\]netlab\[\033[0m\]:\w# '

_lab_complete() {
  local cmds="list next start show check answer hint solution reset quiz subnet help progress-reset"
  [ "$COMP_CWORD" -eq 1 ] && COMPREPLY=($(compgen -W "$cmds" -- "${COMP_WORDS[1]}"))
}
complete -F _lab_complete lab

# Welcome banner + rebuild the lab you were on, only in the first (top-level) shell.
if [ -z "$NETLAB_BOOTED" ] && [ -z "$(ip netns identify 2>/dev/null)" ] && [ "$NETLAB_ATTACH" != 1 ]; then
  export NETLAB_BOOTED=1
  lab _boot
fi
export NETLAB_BOOTED=1
